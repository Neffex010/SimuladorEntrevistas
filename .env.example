# Copia este archivo como .env para desarrollo local con `netlify dev`.
# No subas tu .env real al repositorio.

# Obligatoria: clave de OpenAI para analizar las respuestas.
OPENAI_API_KEY=

# Orígenes permitidos por CORS, separados por coma.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Límite de solicitudes por IP.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60

# Opcional: Upstash Redis para compartir el límite entre instancias.
# Sin estas variables, el límite se guarda en memoria.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
